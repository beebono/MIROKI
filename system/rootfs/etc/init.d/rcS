#!/bin/sh
# MIROKI system init (busybox init sysinit): modules, scratch mounts, the
# exFAT data partition and the audio routing. Logs to /dev/kmsg, so it shows
# up in dmesg.

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

log() {
    echo "miroki: $*" > /dev/kmsg
}

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp

# Modules first. The audio nodes take their power domain from
# sprd-audcp-boot (it boots the DSP with /lib/firmware/agdsp.bin) and stop
# waiting for it when the deferred probe timeout (10 s after late_initcall)
# runs out.
for m in sprd-audcp-boot mali_kbase; do
    modprobe "$m" || log "modprobe $m failed"
done

# /dev node of the eMMC partition named $1 (same as the initramfs's).
find_part() {
    for d in /sys/class/block/*; do
        [ -f "$d/partition" ] || continue
        grep -qx "PARTNAME=$1" "$d/uevent" || continue
        disk=$(basename "$(dirname "$(readlink -f "$d")")")
        [ "$(cat "/sys/class/block/$disk/device/type" 2>/dev/null)" = MMC ] || continue
        echo "/dev/${d##*/}"
        return 0
    done
    return 1
}

# Data: ROMs, saves, config. Formatted only when it carries no exFAT
# signature at all (a first boot); an exFAT volume that fails to mount gets a
# fsck instead, never a format.
mount_data() {
    dev=$(find_part data) || { log "no data partition on the eMMC"; return 1; }
    # An unreadable device also shows no signature: never format on that.
    dd if="$dev" of=/dev/null bs=64k count=16 2>/dev/null || { log "$dev unreadable"; return 1; }
    type=$(blkid "$dev" | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p')
    if [ "$type" != exfat ]; then
        log "$dev holds ${type:-no filesystem}, formatting it exFAT"
        mkfs.exfat -L MIROKI "$dev" > /dev/kmsg 2>&1 || { log "mkfs.exfat failed"; return 1; }
    fi
    if ! mount -t exfat -o noatime "$dev" /data; then
        log "$dev: exFAT mount failed, running fsck.exfat"
        fsck.exfat -y "$dev" > /dev/kmsg 2>&1
        mount -t exfat -o noatime "$dev" /data || { log "$dev: still not mountable"; return 1; }
    fi
    log "data $dev mounted on /data"
}
mount_data

# Audio routing, from ROCKNIX's sprdphone-sc2730 UCM BootSequence by way of
# old MIROKI. The speaker is the codec's HP path into the external AW87390
# amp, not the SPK pin. No "DSP VBC Profile Select": the driver only keeps a
# selection that indexes a profile loaded through "DSP VBC Profile Update"
# (the dsp_vbc firmware stock loads from /vendor/firmware), so without that
# blob it is a no-op and the DSP runs untuned.
mix() {
    tmix "$@" > /dev/null 2> /dev/kmsg || log "tmix '$1' failed"
}
audio_init() {
    i=0
    while [ ! -e /dev/snd/controlC0 ]; do
        i=$((i + 1))
        [ $i -eq 100 ] && { log "no sound card after 10s"; return 1; }
        sleep 0.1
    done
    mix 'HP mix mode' 0
    mix 'HPL EAR Sel' HPL
    mix 'VBC DAC0 DG Set' 63,63
    mix 'HPL Gain HPL Playback Volume' 8
    mix 'HPR Gain HPR Playback Volume' 8
    mix 'VBC_MIXER0_DAC0' HALF_ADD
    mix 'DAC LRCLK Select' invert
    mix 'agdsp_access_en' on
    mix 'S_NORMAL_AP01_P_CODEC SWITCH' on
    mix 'VBC_DAC0_DP_EN' enable
    mix 'HPL Mixer DACLHPL Switch' on
    mix 'HPR Mixer DACRHPR Switch' on
    mix 'Speaker Function' on
    mix 'Speaker1 Function' on
    mix 'VBC DAC0 AUD MDG Set' 1,1024

    # Softvol's control (/etc/asound.conf) only exists once the default PCM
    # has been opened: open it, then set the starting level (of 0..15).
    tone 0 2> /dev/kmsg || log "opening the default PCM failed"
    mix 'MIROKI Playback Volume' 6
}
audio_init
